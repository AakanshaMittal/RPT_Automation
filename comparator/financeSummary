# =========================================================
# DOWNLOAD APP FILES FROM API
# =========================================================
def download_app_files():
    os.makedirs(APP_FOLDER, exist_ok=True)

    for tc_no in sorted(API_ENDPOINTS.keys()):
        endpoint = API_ENDPOINTS[tc_no]
        url = f"{API_BASE_URL}{endpoint}"

        print(f"⬇️ Downloading APP file for T{tc_no}: {url}")

        response = requests.get(url, timeout=30, verify=False)

        if response.status_code != 200:
            raise RuntimeError(f"Failed to download APP file for T{tc_no}")

        file_path = os.path.join(APP_FOLDER, f"T{tc_no}_App.xlsx")
        with open(file_path, "wb") as f:
            f.write(response.content)

        print(f"✅ Saved APP file: {file_path}")

# =========================================================
# READ KEY–VALUE PAIRS
# =========================================================
def read_key_values(ws, start_row=2, end_row=6):
    keyvals = {}
    for row in ws.iter_rows(min_row=start_row, max_row=end_row, values_only=True):
        if row[0]:
            key = str(row[0]).strip()
            value = "" if row[1] is None else str(row[1]).strip()
            keyvals[key] = value
    return keyvals

# =========================================================
# EXTRACT TABLES
# =========================================================
def extract_tables(ws, start_row=7):
    tables = []
    current_data = []

    for row in ws.iter_rows(min_row=start_row, values_only=True):
        if all(cell is None for cell in row):
            if current_data:
                tables.append(pd.DataFrame(current_data).fillna(""))
                current_data = []
        else:
            current_data.append(row)

    if current_data:
        tables.append(pd.DataFrame(current_data).fillna(""))

    return tables

# =========================================================
# NUMERIC CHECK
# =========================================================
def is_numeric(val):
    try:
        float(val)
        return True
    except:
        return False

# =========================================================
# KEY–VALUE COMPARISON
# =========================================================
def compare_key_values(kv1, kv2):
    mismatches = []
    keys = set(kv1.keys()).union(kv2.keys())

    for key in keys:
        v1 = kv1.get(key, "<Missing>")
        v2 = kv2.get(key, "<Missing>")
        if v1 != v2:
            mismatches.append((key, v1, v2))

    return mismatches

# =========================================================
# TABLE COMPARISON
# =========================================================
def compare_tables(t1, t2):
    max_r = max(t1.shape[0], t2.shape[0])
    max_c = max(t1.shape[1], t2.shape[1])

    mismatch_matrix = [[False] * max_c for _ in range(max_r)]
    mismatches = []

    for r in range(max_r):
        for c in range(max_c):
            v1 = t1.iloc[r, c] if r < t1.shape[0] and c < t1.shape[1] else ""
            v2 = t2.iloc[r, c] if r < t2.shape[0] and c < t2.shape[1] else ""

            if v1 == "" and v2 == "":
                continue

            if is_numeric(v1) and is_numeric(v2):
                if abs(float(v1) - float(v2)) > TOLERANCE:
                    mismatch_matrix[r][c] = True
                    mismatches.append((r + 1, c + 1, v1, v2))
            else:
                if str(v1) != str(v2):
                    mismatch_matrix[r][c] = True
                    mismatches.append((r + 1, c + 1, v1, v2))

    return mismatches, mismatch_matrix, max_r, max_c

# =========================================================
# HTML REPORT
# =========================================================
def html_format_table(t1, t2, mismatch_matrix, rows, cols):
    lines = ["<table border='1' cellpadding='5' cellspacing='0' style='border-collapse: collapse;'>"]

    for r in range(rows):
        lines.append("<tr>")
        for c in range(cols):
            v1 = t1.iloc[r, c] if r < t1.shape[0] and c < t1.shape[1] else ""
            v2 = t2.iloc[r, c] if r < t2.shape[0] and c < t2.shape[1] else ""

            bg = "background-color:#ffb3b3;" if mismatch_matrix[r][c] else ""
            content = f"{html.escape(str(v1))} | {html.escape(str(v2))}"
            lines.append(f"<td style='{bg}'>{content}</td>")
        lines.append("</tr>")

    lines.append("</table>")
    return "\n".join(lines)

def generate_html_report(key_mismatches, table_data, file1, file2, output):
    html_parts = []

    html_parts.append("<h1>Excel Comparison Report</h1>")
    html_parts.append(f"<p><b>File 1:</b> {file1}<br><b>File 2:</b> {file2}</p>")

    html_parts.append("<h2>Key–Value Mismatches</h2>")
    if not key_mismatches:
        html_parts.append("<p>No mismatches ✅</p>")
    else:
        html_parts.append("<table border='1'><tr><th>Key</th><th>File1</th><th>File2</th></tr>")
        for k, v1, v2 in key_mismatches:
            html_parts.append(f"<tr><td>{k}</td><td>{v1}</td><td>{v2}</td></tr>")
        html_parts.append("</table>")

    html_parts.append("<h2>Tables</h2>")
    for idx, (mis, matrix, rows, cols, t1, t2) in enumerate(table_data, start=1):
        html_parts.append(f"<h3>Table {idx}</h3>")
        html_parts.append(html_format_table(t1, t2, matrix, rows, cols))

    with open(output, "w", encoding="utf-8") as f:
        f.write("\n".join(html_parts))

# =========================================================
# CONSOLIDATED EXCEL REPORT
# =========================================================
def generate_consolidated_excel(results, output_file):
    df = pd.DataFrame(results)

    with pd.ExcelWriter(output_file, engine="openpyxl") as writer:
        df.to_excel(writer, index=False, sheet_name="Summary")

    print(f"✅ Consolidated Excel report generated: {output_file}")

