if __name__ == "__main__":

    os.makedirs(REPORT_FOLDER, exist_ok=True)
    download_app_files()

    consolidated_results = []

    for tc_no in sorted(API_ENDPOINTS.keys()):
        app_file = os.path.join(APP_FOLDER, f"T{tc_no}_App.xlsx")
        exc_file = os.path.join(EXC_FOLDER, f"T{tc_no}_Exc.xlsx")

        print(f"\n🔍 Comparing T{tc_no}")

        if not os.path.exists(app_file) or not os.path.exists(exc_file):
            print("❌ Missing file")
            continue

        report_path = os.path.join(REPORT_FOLDER, f"T{tc_no}_Report.html")

        wb1 = load_workbook(app_file)
        wb2 = load_workbook(exc_file)

        ws1 = wb1.active
        ws2 = wb2.active

        kv1 = read_key_values(ws1)
        kv2 = read_key_values(ws2)
        key_mismatches = compare_key_values(kv1, kv2)

        tables1 = extract_tables(ws1)
        tables2 = extract_tables(ws2)

        table_mismatch_count = 0
        max_tables = max(len(tables1), len(tables2))

        for i in range(max_tables):
            t1 = tables1[i] if i < len(tables1) else pd.DataFrame()
            t2 = tables2[i] if i < len(tables2) else pd.DataFrame()
            mismatches, _, _, _ = compare_tables(t1, t2)
            table_mismatch_count += len(mismatches)

        consolidated_results.append({
            "Test Case": f"T{tc_no}",
            "Key Mismatches": len(key_mismatches),
            "Table Mismatches": table_mismatch_count,
            "Status": "PASS" if len(key_mismatches) == 0 and table_mismatch_count == 0 else "FAIL"
        })

        # Existing HTML reporting
        table_data = []
        for i in range(max_tables):
            t1 = tables1[i] if i < len(tables1) else pd.DataFrame()
            t2 = tables2[i] if i < len(tables2) else pd.DataFrame()
            table_data.append((*compare_tables(t1, t2), t1, t2))

        generate_html_report(key_mismatches, table_data, app_file, exc_file, report_path)

    consolidated_file = os.path.join(REPORT_FOLDER, "Consolidated_Report.xlsx")
    generate_consolidated_excel(consolidated_results, consolidated_file)

    print("\n✅ All comparisons completed successfully.")